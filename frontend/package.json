{
  "name": "cortex-bridge-ui",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@11.18.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3420",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3420",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:runtime",
    "test:unit": "vitest run",
    "test:runtime": "tsx --test lib/runtimeTruth.test.mts test/privacy.test.mts",
    "test:coverage": "vitest run --coverage && npm run test:runtime",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.12.1",
    "jsdom": "26.1.0",
    "oxlint": "1.75.0",
    "tailwindcss": "^4",
    "tsx": "4.20.6",
    "typescript": "^5",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.23",
    "next": {
      "sharp": "0.35.0"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents": false
  }
}
