{
  "name": "cortex-bridge-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3420",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3420",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:runtime",
    "test:unit": "vitest run",
    "test:runtime": "tsx --test lib/runtimeTruth.test.mts",
    "test:coverage": "vitest run --coverage && npm run test:runtime",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "3.2.4",
    "axe-core": "4.12.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "26.1.0",
    "tailwindcss": "^4",
    "tsx": "4.20.6",
    "typescript": "^5",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
