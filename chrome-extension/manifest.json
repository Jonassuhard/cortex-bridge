{
  "manifest_version": 3,
  "name": "Cortex Bridge",
  "description": "Connects the local Cortex Bridge application to ChatGPT tabs selected by the user.",
  "version": "0.5.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "debugger",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8420/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Cortex Bridge"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:8420/*"],
      "js": ["cortex-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["chatgpt-content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:8420 http://127.0.0.1:8420"
  }
}
