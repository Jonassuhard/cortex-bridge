# Secrets — never commit these
.env
.env.*
*.pem
*_key
auth.json

# OS noise
.DS_Store

# Local model blobs (models live in your Ollama store, not in this repo)
models/
*.gguf

# Python
__pycache__/
*.pyc
.venv/

# Console runtime data (iteration store)
console/data/

# Local Codex profile state (contains session data)
state_*.sqlite*
logs_*.sqlite
sessions/

# Frontend build artifacts
frontend/node_modules/
frontend/.next/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/

# Isolated implementation and review workspaces
.worktrees/
.superpowers/
